# Token from @BotFather (required)
BOT_TOKEN=
# Comma-separated numeric Telegram user IDs of super admins
ADMIN_IDS=123456789,987654321
# SQLite database path
DB_PATH=bot.db
# Optional: the group chat id (e.g. -1001234567890)
GROUP_ID=
# Who students should contact when their code is not found (e.g. @support_username)
DEFAULT_CONTACT=
# Optional: proxy for api.telegram.org if it is blocked on the server
# (http://host:port or socks5://user:pass@host:port)
PROXY_URL=
